<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Shield outer shadow / glow -->
    <path
        android:pathData="M54,23 L76,33 C76,55 67,69 54,77 C41,69 32,55 32,33 Z"
        android:fillColor="#00E5FF"
        android:fillAlpha="0.15" />

    <!-- Main Shield -->
    <path
        android:pathData="M54,25 L74,34 C74,53 66,66 54,74 C42,66 34,53 34,34 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="34"
                android:startY="25"
                android:endX="74"
                android:endY="74"
                android:type="linear">
                <item android:color="#00E5FF" android:offset="0.0" />
                <item android:color="#3B82F6" android:offset="0.6" />
                <item android:color="#6366F1" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Shield Inner Core -->
    <path
        android:pathData="M54,29 L70,36.5 C70,51.5 63.5,62 54,68.5 C44.5,62 38,51.5 38,36.5 Z"
        android:fillColor="#091428" />

    <!-- Inner Chromium / Globe Orbital Rings & Security Lock -->
    <!-- Globe Circle -->
    <path
        android:pathData="M54,40 A10,10 0 1,0 54,60 A10,10 0 1,0 54,40"
        android:strokeColor="#38BDF8"
        android:strokeWidth="1.8"
        android:fillColor="#00000000" />

    <!-- Globe Latitude / Longitude lines -->
    <path
        android:pathData="M44,50 L64,50"
        android:strokeColor="#38BDF8"
        android:strokeWidth="1.2" />
    <path
        android:pathData="M54,40 C58,44 58,56 54,60 C50,56 50,44 54,40"
        android:strokeColor="#38BDF8"
        android:strokeWidth="1.2"
        android:fillColor="#00000000" />

    <!-- Privacy Checkmark / Keyhole in the center -->
    <path
        android:pathData="M48.5,50 L52.5,54 L60,46"
        android:strokeColor="#10B981"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

</vector>
